# Host for alpha-api (Fingrid Connect's backend). Only the host — the app appends the
# versioned /alpha/v1 · /alpha/v2 path prefixes itself. Client-exposed since Connect calls
# alpha-api directly from the browser, so this must stay NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_ALPHA_API_URL=http://localhost:5050

# There is NO tenant setting here, in any environment. The app identifies the tenant by sending
# the browser's own hostname as X-Tenant-Domain, which cosmos-gateway resolves against the
# tenant_domain table. Nothing to configure — but every hostname the app is served from must have
# an ACTIVE row in that table, "localhost" included, or calls return 404 {"error":"Unknown tenant"}.

# Gates the Fingrid Connect zone (Community nav button + all /connect/* routes).
ENABLE_CONNECT=false

# --- Demo request mail (AWS SES) ---
# All three must be set for /api/demo-request to send. Leave them unset locally and the
# route still succeeds — it logs the submission and warns that mail is off.
AWS_REGION=ap-south-1
# Must be a verified SES identity (the address itself or its domain), and the account
# must be out of the SES sandbox to reach unverified recipients.
SES_FROM=noreply@fingrid.ai
# Where leads land. Comma-separated for multiple recipients.
DEMO_REQUEST_TO=sreedhar@fingrid.ai

# Credentials for the above. Leave both unset when running on AWS — the SDK resolves them
# from the instance/task IAM role instead, which is the safer option. Off AWS, set them to
# an IAM user whose policy allows ses:SendEmail.
# NEVER commit real values: fill these in .env (git-ignored), not here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
