# Host for alpha-api (Fingrid Connect's backend). Only the host — the app appends the
# versioned /alpha/v1 · /alpha/v2 path prefixes itself. Client-exposed since Connect calls
# alpha-api directly from the browser, so this must stay NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_ALPHA_API_URL=http://localhost:5050

# There is NO tenant setting here, in any environment. The app identifies the tenant by sending
# the browser's own hostname as X-Tenant-Domain, which cosmos-gateway resolves against the
# tenant_domain table. Nothing to configure — but every hostname the app is served from must have
# an ACTIVE row in that table, "localhost" included, or calls return 404 {"error":"Unknown tenant"}.

# Gates the Fingrid Connect zone (Community nav button + all /connect/* routes).
ENABLE_CONNECT=false
